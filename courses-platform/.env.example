# ============================================================================
# منصة الدورات المجانية — متغيرات البيئة
# انسخ هذا الملف إلى .env وعدّل القيم حسب الحاجة.
# ============================================================================

# --- قاعدة البيانات (إلزامي) ---
# للتشغيل المحلي: ملف SQLite عادي، لا حاجة لأي إعداد إضافي.
DATABASE_URL="file:./dev.db"

# --- الجلسات / التوقيع (إلزامي) ---
# مفتاح سري لتوقيع جلسات JWT. يجب أن يكون نصًا عشوائيًا طويلاً وفريدًا في الإنتاج.
# يمكنك توليد واحد عبر: openssl rand -base64 48
AUTH_SECRET="dev-only-insecure-secret-change-me-please-32chars-min"

# --- عنوان الموقع (اختياري، يُستخدم في الروابط المُرسلة كنص فقط) ---
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ============================================================================
# الإعدادات التالية اختيارية بالكامل — المنصة تعمل بدونها في "وضع التطوير"
# ============================================================================

# --- Turso (قاعدة بيانات سحابية مجانية متوافقة مع SQLite للإنتاج) ---
# مطلوبة فقط عند النشر على استضافة بلا قرص دائم مثل Vercel.
# اتركها فارغة للتشغيل المحلي — سيُستخدم DATABASE_URL أعلاه تلقائيًا.
# TURSO_DATABASE_URL="libsql://your-db-name.turso.io"
# TURSO_AUTH_TOKEN="your-turso-auth-token"

# --- Resend (إرسال بريد فعلي لاستعادة كلمة المرور) ---
# بدون هذا المفتاح: تظهر رسالة "استعادة كلمة المرور" برابط الاستعادة مباشرة على
# الشاشة (وتُطبع في الطرفية) بدل إرسال بريد فعلي — مناسب للتطوير والتجربة فورًا.
# RESEND_API_KEY="re_xxxxxxxxxxxx"
# RESEND_FROM_EMAIL="onboarding@resend.dev"
