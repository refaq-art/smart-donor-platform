rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.email.lower() == 'mshary307@gmail.com';
    }

    function ownsOrg(orgId) {
      return signedIn() && request.auth.uid == orgId;
    }

    match /organizations/{orgId} {
      allow create: if signedIn() && request.auth.uid == orgId;
      allow read, update, delete: if ownsOrg(orgId) || isAdmin();
    }

    match /organizations/{orgId}/{document=**} {
      allow read, write: if ownsOrg(orgId) || isAdmin();
    }
  }
}
