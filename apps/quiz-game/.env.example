# === قاعدة البيانات ===
# سلسلة اتصال PostgreSQL. مثال محلي (بعد تشغيل Postgres عبر Docker أو محليًا):
DATABASE_URL="postgresql://quiz:quiz@localhost:5432/arabic_quiz_arena?schema=public"

# === الجلسات / المصادقة ===
# مفتاح سري لتوقيع جلسات JWT — غيّره في الإنتاج (يمكن توليده بـ: openssl rand -base64 32)
SESSION_SECRET="change-this-to-a-long-random-secret-in-production"

# === خادم الاستضافة ===
PORT=3000
NODE_ENV=development

# === توليد الأسئلة بالذكاء الاصطناعي (اختياري) ===
# إن تُرك فارغًا يعمل النظام بمزوّد تجريبي (Mock) يولّد أسئلة نموذجية دون أي اتصال خارجي.
# لتفعيل التوليد الحقيقي، ضع رابط ومفتاح أي واجهة متوافقة مع OpenAI Chat Completions.
#
# مزوّد مجاني موصى به: Groq (https://console.groq.com) — تسجيل بالبريد فقط، بلا بطاقة ائتمان،
# خطة مجانية سخية (٣٠ طلبًا/دقيقة، حتى ١٤٬٤٠٠ طلب/يوم). بعد إنشاء المفتاح من "API Keys" في
# لوحة Groq، فعّله بضبط القيم التالية (متوافقة تلقائيًا مع الكود الحالي دون أي تعديل):
# AI_PROVIDER_BASE_URL="https://api.groq.com/openai/v1"
# AI_PROVIDER_API_KEY="gsk_...."
# AI_PROVIDER_MODEL="llama-3.3-70b-versatile"
AI_PROVIDER_BASE_URL=""
AI_PROVIDER_API_KEY=""
AI_PROVIDER_MODEL="gpt-4o-mini"
