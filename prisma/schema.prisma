// مخطط قاعدة البيانات لمنصة إدارة مشاريع ومنح الجمعيات الخيرية
generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
  // "native" لبيئة التطوير المحلية، و"rhel-openssl-3.0.x" لبيئة تشغيل Vercel
  // (Amazon Linux 2023) — بدونه لا يجد Prisma محرك الاستعلامات المناسب وقت التشغيل.
  binaryTargets   = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// الأدوار المتاحة (كسلسلة نصية لأن SQLite لا يدعم enum):
// ADMIN = مدير النظام | ORG_MANAGER = مدير الجمعية | GRANTS_OFFICER = مسؤول المنح
// REVIEWER = مراجع | FINANCE_REVIEWER = مراجع مالي
model User {
  id                 String       @id @default(cuid())
  name               String
  email              String       @unique
  passwordHash       String
  role               String       @default("GRANTS_OFFICER")
  organizationId     String
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  isActive           Boolean      @default(true)
  // يُجبر المستخدم على تغيير كلمة المرور عند أول دخول (الحسابات المُنشأة بواسطة المدير)
  mustChangePassword Boolean      @default(false)
  lastLoginAt        DateTime?
  // إبطال الجلسات: أي جلسة صدرت قبل هذا التاريخ تُرفض
  sessionsValidFrom  DateTime     @default(now())
  isDemo             Boolean      @default(false)
  createdAt          DateTime     @default(now())

  createdProjects      Project[]                  @relation("ProjectCreatedBy")
  assignedApplications GrantApplication[]         @relation("ApplicationAssignedTo")
  createdApplications  GrantApplication[]         @relation("ApplicationCreatedBy")
  statusChanges        ApplicationStatusHistory[]
  activityLogs         ActivityLog[]
  comments             ApplicationComment[]
  applicationVersions  ApplicationVersion[]
  uploadedDocuments    OrgDocument[]

  @@index([organizationId])
}

// ملف الجمعية المركزي — مصدر واحد للحقيقة لبيانات الجمعية، تُستورد منه بيانات
// طلبات المنح تلقائيًا بدل إعادة إدخالها في كل طلب.
model Organization {
  id          String  @id @default(cuid())
  name        String
  about       String?
  accentColor String  @default("#0f766e")
  isDemo      Boolean @default(false)

  // بيانات الترخيص
  regNumber       String?
  licenseDate     DateTime?
  licenseExpiry   DateTime?
  supervisingBody String? // الجهة المشرفة
  foundedAt       DateTime?

  // النشاط والنطاق
  sector          String? // مجال الجمعية
  geographicScope String?
  city            String?
  strategicGoals  String? // JSON string[]

  // التواصل
  phone   String?
  email   String?
  website String?
  address String?

  // المفوض
  delegateName  String?
  delegateRole  String?
  delegatePhone String?
  delegateEmail String?

  // المالية
  bankName     String?
  iban         String?
  annualBudget Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users         User[]
  projects      Project[]
  donors        Donor[]
  opportunities FundingOpportunity[]
  applications  GrantApplication[]
  documents     OrgDocument[]
  boardMembers  BoardMember[]
  activityLogs  ActivityLog[]
  donorLeads    DonorLead[]
}

// أعضاء مجلس الإدارة والفريق التنفيذي
model BoardMember {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  position       String?
  // BOARD = مجلس إدارة | EXECUTIVE = فريق تنفيذي
  memberType     String       @default("BOARD")
  phone          String?
  email          String?
  isDemo         Boolean      @default(false)
  createdAt      DateTime     @default(now())

  @@index([organizationId])
}

// مكتبة المستندات المركزية — مستند واحد يُعاد استخدامه في عدة طلبات، مع تتبع الصلاحية
model OrgDocument {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  title          String
  // التصنيف: ترخيص، قوائم مالية، خطة استراتيجية، شهادة حوكمة، تقرير سنوي، أخرى...
  category       String
  filename       String
  storedName     String
  url            String
  mimeType       String
  size           Int
  issueDate      DateTime?
  expiryDate     DateTime?
  notes          String?
  uploadedById   String?
  uploadedBy     User?        @relation(fields: [uploadedById], references: [id])
  isDemo         Boolean      @default(false)
  uploadedAt     DateTime     @default(now())

  @@index([organizationId])
  @@index([category])
}

model Project {
  id                  String       @id @default(cuid())
  organizationId      String
  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  title               String
  category            String?
  problemStatement    String?
  generalObjective    String?
  specificObjectives  String? // JSON string[]
  beneficiaryCategory String?
  beneficiaryCount    Int?
  geographicScope     String?
  activities          String? // JSON string[]
  outputs             String? // JSON string[]
  outcomes            String? // JSON string[]
  kpis                String? // JSON [{indicator, target}]
  timelineStart       DateTime?
  timelineEnd         DateTime?
  budgetTotal         Float?
  budgetBreakdown     String? // JSON [{item, amount}]
  status              String       @default("مسودة") // مسودة / نشط / مؤرشف
  isDemo              Boolean      @default(false)
  duplicatedFromId    String?
  createdById         String
  createdBy           User         @relation("ProjectCreatedBy", fields: [createdById], references: [id])
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  attachments   Attachment[]
  applications  GrantApplication[]
  opportunities FundingOpportunity[]
  donorLeadMatches DonorLead[]
}

model Donor {
  id                 String       @id @default(cuid())
  organizationId     String
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name               String
  type               String? // شركة / مؤسسة مانحة / جهة حكومية / فرد
  supportFields      String? // مجالات الدعم
  fundingConditions  String?
  contactName        String?
  phone              String?
  email              String?
  city               String?
  relationshipStatus String       @default("محتمل") // محتمل / نشط / متوقف
  notes              String?
  isDemo             Boolean      @default(false)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  opportunities FundingOpportunity[]
  attachments   Attachment[]
}

// مانح مُكتشف تلقائيًا عبر البحث اليومي بالذكاء الاصطناعي (src/lib/donor-discovery.ts).
// يبقى "مقترحًا" (PENDING) حتى يراجعه مستخدم بشري ويحوّله يدويًا إلى Donor فعلي —
// المساعد الذكي لا يُدرج بيانات في جداول الجمعية الحقيقية دون مراجعة بشرية.
model DonorLead {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name  String
  about String?
  sector String?
  city   String?
  website String?

  // مصدر الاكتشاف — رابط ونص مقتطف من نتيجة البحث، للتحقق اليدوي من صحة المعلومة
  sourceUrl     String?
  sourceSnippet String?

  // اقتراح المشروع الأنسب لرفعه لهذا المانح (اختياري، null إن لم يظهر تطابق واضح)
  suggestedProjectId String?
  suggestedProject   Project? @relation(fields: [suggestedProjectId], references: [id], onDelete: SetNull)
  matchReason        String?

  // ملاحظة اتجاه/توجه عام لاحظه المساعد الذكي أثناء هذا الاكتشاف (اختياري)
  trendNote String?

  // PENDING = مقترح ينتظر المراجعة | ADDED = أُضيف كمانح فعلي | DISMISSED = تم تجاهله
  status String @default("PENDING")

  isDemo      Boolean  @default(false)
  discoveredAt DateTime @default(now())
  reviewedAt  DateTime?

  @@index([organizationId])
  @@index([status])
}

model FundingOpportunity {
  id                String       @id @default(cuid())
  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  title             String
  donorId           String?
  donor             Donor?       @relation(fields: [donorId], references: [id])
  donorNameFreeText String?
  field             String?
  expectedAmount    Float?
  requirements      String?
  startDate         DateTime?
  deadline          DateTime?
  applicationUrl    String?
  status            String       @default("مفتوحة") // مفتوحة / تحت المتابعة / مغلقة
  projectId         String?
  project           Project?     @relation(fields: [projectId], references: [id])
  isDemo            Boolean      @default(false)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  applications GrantApplication[]
  criteria     EligibilityCriterion[]
}

model GrantApplication {
  id             String              @id @default(cuid())
  organizationId String
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  title          String
  projectId      String
  project        Project             @relation(fields: [projectId], references: [id])
  opportunityId  String?
  opportunity    FundingOpportunity? @relation(fields: [opportunityId], references: [id])

  executiveSummary   String?
  orgIntroduction    String?
  problemStatement   String?
  justification      String?
  objectives         String?
  beneficiaries      String?
  implementationPlan String?
  activities         String?
  outputs            String?
  outcomes           String?
  kpis               String?
  riskManagement     String?
  sustainability     String?
  timeline           String?
  budget             String?
  donorRequirements  String?

  status       String   @default("مسودة")
  isDemo       Boolean  @default(false)
  assignedToId String?
  assignedTo   User?    @relation("ApplicationAssignedTo", fields: [assignedToId], references: [id])
  createdById  String
  createdBy    User     @relation("ApplicationCreatedBy", fields: [createdById], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  statusHistory ApplicationStatusHistory[]
  attachments   Attachment[]
  comments      ApplicationComment[]
  versions      ApplicationVersion[]
}

model ApplicationStatusHistory {
  id            String           @id @default(cuid())
  applicationId String
  application   GrantApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  fromStatus    String?
  toStatus      String
  note          String?
  nextStep      String?
  changedById   String?
  changedBy     User?            @relation(fields: [changedById], references: [id])
  createdAt     DateTime         @default(now())
}

model Attachment {
  id            String            @id @default(cuid())
  filename      String
  storedName    String
  url           String
  mimeType      String
  size          Int
  projectId     String?
  project       Project?          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  applicationId String?
  application   GrantApplication? @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  donorId       String?
  donor         Donor?            @relation(fields: [donorId], references: [id], onDelete: Cascade)
  uploadedAt    DateTime          @default(now())
}

model ActivityLog {
  id             String        @id @default(cuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String?
  user           User?         @relation(fields: [userId], references: [id])
  action         String
  entityType     String
  entityId       String
  details        String?
  createdAt      DateTime      @default(now())
}

// ─────────────────────────────────────────────────────────────────────────────
// محرك أهلية المنح
// ─────────────────────────────────────────────────────────────────────────────

// شرط أهلية مرتبط بفرصة تمويل. القواعد قابلة للإضافة والتعديل من الواجهة
// دون أي تعديل في الكود — كل شرط يحدد "مفتاحًا" يُقيَّم آليًا مقابل بيانات
// الجمعية/المشروع، أو يكون تحققًا يدويًا يؤكده المستخدم.
model EligibilityCriterion {
  id               String             @id @default(cuid())
  opportunityId    String
  opportunity      FundingOpportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  // مفتاح الشرط، مثل: ORG_AGE_YEARS, ORG_SECTOR, BENEFICIARY_COUNT,
  // PROJECT_BUDGET, SELF_CONTRIBUTION_PCT, ADMIN_COST_PCT, HAS_DOCUMENT, MANUAL
  ruleKey          String
  label            String
  // عامل المقارنة: GTE, LTE, EQ, IN, EXISTS, BOOLEAN
  operator         String
  // القيمة المرجعية (نص أو رقم أو قائمة مفصولة بفواصل حسب العامل)
  value            String?
  // للشروط من نوع HAS_DOCUMENT: تصنيف المستند المطلوب
  documentCategory String?
  // إلزامي = عدم استيفائه يعني "غير مؤهل"؛ غير إلزامي = "مؤهل بشروط"
  isMandatory      Boolean            @default(true)
  notes            String?
  isDemo           Boolean            @default(false)
  createdAt        DateTime           @default(now())

  @@index([opportunityId])
}

// ─────────────────────────────────────────────────────────────────────────────
// المراجعة والتعليقات
// ─────────────────────────────────────────────────────────────────────────────

// تعليق مرتبط بحقل محدد داخل طلب المنحة (أو تعليق عام إذا كان fieldKey فارغًا)
model ApplicationComment {
  id            String           @id @default(cuid())
  applicationId String
  application   GrantApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  // مفتاح الحقل الذي يعلّق عليه المراجع (مثل executiveSummary)، أو null لتعليق عام
  fieldKey      String?
  body          String
  // OPEN = مفتوح | RESOLVED = تمت المعالجة
  status        String           @default("OPEN")
  // CHANGE_REQUEST = طلب تعديل | NOTE = ملاحظة
  kind          String           @default("NOTE")
  authorId      String
  author        User             @relation(fields: [authorId], references: [id])
  resolvedAt    DateTime?
  isDemo        Boolean          @default(false)
  createdAt     DateTime         @default(now())

  @@index([applicationId])
}

// لقطة من محتوى الطلب عند كل حفظ مهم — تتيح مقارنة الإصدارات واستعادتها
model ApplicationVersion {
  id            String           @id @default(cuid())
  applicationId String
  application   GrantApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  // كامل محتوى أقسام الطلب وقت الحفظ كـ JSON
  snapshot      String
  createdById   String?
  createdBy     User?            @relation(fields: [createdById], references: [id])
  label         String?
  createdAt     DateTime         @default(now())

  @@index([applicationId])
}

// ═══════════════════════════════════════════════════════════════════════════
// وحدة منفصلة تمامًا: نظام إدارة العملاء والمهل والأقساط والدفعات
// (لأفراد يقرضون عملاءهم مبالغ ويستردونها بنظام مهلة أو أقساط)
//
// هذه الوحدة مستقلة كليًا عن باقي المخطط أعلاه (منصة المشاريع والمنح):
// - كل نماذجها مسبوقة بـ Lm (Lending Module) ولا تربطها أي علاقة بنماذج
//   الجمعية/المشاريع/المنح.
// - لها نظام مصادقة خاص بها (رقم جوال + كلمة مرور، جلسة JWT منفصلة).
// - تتشارك فقط في نفس ملف/اتصال قاعدة البيانات (SQLite) كوسيلة تشغيل عملية
//   بدون تكلفة إضافية، مع عزل بيانات كامل عبر userId في كل استعلام.
// ═══════════════════════════════════════════════════════════════════════════

// حساب مستخدم الوحدة. role: USER = مستخدم عادي (يرى بياناته فقط) |
// ADMIN = مدير عام (صلاحيات كاملة على كل حسابات الوحدة).
model LmUser {
  id                String    @id @default(cuid())
  phone             String    @unique
  passwordHash      String
  name              String
  role              String    @default("USER")
  isActive          Boolean   @default(true)
  // إبطال الجلسات الصادرة قبل هذا التاريخ (تغيير كلمة المرور/تعطيل الحساب)
  sessionsValidFrom DateTime  @default(now())
  lastLoginAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  customers    LmCustomer[]
  transactions LmTransaction[]

  @@index([phone])
}

// عميل يخص مستخدمًا واحدًا فقط. الاسم هو الحقل الوحيد المطلوب عمدًا.
model LmCustomer {
  id        String   @id @default(cuid())
  userId    String
  user      LmUser   @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions LmTransaction[]

  @@index([userId])
}

// عملية مالية: مهلة (GRACE) أو أقساط (INSTALLMENT).
// لتوحيد منطق توزيع الدفعات، تُمثَّل عملية "المهلة" داخليًا بقسط واحد فقط
// (LmInstallment) بقيمة الإجمالي وتاريخ استحقاق واحد — بدل تكرار منطق منفصل.
model LmTransaction {
  id     String @id @default(cuid())
  userId String
  user   LmUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  customerId String
  customer   LmCustomer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  // GRACE = مهلة | INSTALLMENT = أقساط
  type      String
  principal Float
  interest  Float
  // = principal + interest، محسوب ومخزَّن وقت الإنشاء لتفادي إعادة حسابه دائمًا
  totalAmount Float

  startDate DateTime
  // المهلة فقط: عدد الأشهر
  months Int?
  // الأقساط فقط: عدد الأقساط
  installmentsCount Int?

  // ذاكرة مخبأة (Cache) لمجموع الدفعات — تُحدَّث فقط داخل معاملة قاعدة بيانات
  // عند تسجيل/حذف دفعة، ولا تُستخدم أبدًا كمصدر وحيد للحقيقة (يُعاد اشتقاقها
  // من جدول الدفعات عند أي شك). الحالة (قادم/متأخر/...) تُشتق دائمًا لحظيًا
  // من التواريخ والمبالغ الفعلية، ولا تُخزَّن كحقل — لأنها تتغير مع مرور الوقت
  // نفسه دون أي تعديل على البيانات، فتخزينها يعني حتمًا بيانات قديمة.
  paidAmount Float @default(0)

  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  installments LmInstallment[]
  payments     LmPayment[]

  @@index([userId])
  @@index([customerId])
}

model LmInstallment {
  id            String        @id @default(cuid())
  transactionId String
  transaction   LmTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  number     Int
  dueDate    DateTime
  amount     Float
  paidAmount Float @default(0)

  allocations LmPaymentAllocation[]

  @@index([transactionId])
}

// دفعة واحدة مسجَّلة على عملية؛ قد تُوزَّع على أكثر من قسط (LmPaymentAllocation).
model LmPayment {
  id            String        @id @default(cuid())
  transactionId String
  transaction   LmTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  amount      Float
  paymentDate DateTime
  createdAt   DateTime @default(now())

  allocations LmPaymentAllocation[]

  @@index([transactionId])
}

// سجل توزيع كل دفعة على الأقساط التي غطّتها — يحفظ مقدار ما خُصِّص من كل
// دفعة لكل قسط، ليكون التوزيع قابلاً للتتبع والاسترجاع الدقيق عند الحذف.
model LmPaymentAllocation {
  id            String        @id @default(cuid())
  paymentId     String
  payment       LmPayment     @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  installmentId String
  installment   LmInstallment @relation(fields: [installmentId], references: [id], onDelete: Cascade)
  amount        Float

  @@index([paymentId])
  @@index([installmentId])
}
