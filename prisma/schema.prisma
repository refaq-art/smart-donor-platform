// مخطط قاعدة البيانات لمنصة إدارة مشاريع ومنح الجمعيات الخيرية
generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
  // "native" لبيئة التطوير المحلية، و"rhel-openssl-3.0.x" لبيئة تشغيل Vercel
  // (Amazon Linux 2023) — بدونه لا يجد Prisma محرك الاستعلامات المناسب وقت التشغيل.
  binaryTargets   = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// الأدوار المتاحة (كسلسلة نصية لأن SQLite لا يدعم enum):
// ADMIN = مدير النظام | ORG_MANAGER = مدير الجمعية | GRANTS_OFFICER = مسؤول المنح
// REVIEWER = مراجع | FINANCE_REVIEWER = مراجع مالي
model User {
  id                 String       @id @default(cuid())
  name               String
  email              String       @unique
  passwordHash       String
  role               String       @default("GRANTS_OFFICER")
  organizationId     String
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  isActive           Boolean      @default(true)
  // يُجبر المستخدم على تغيير كلمة المرور عند أول دخول (الحسابات المُنشأة بواسطة المدير)
  mustChangePassword Boolean      @default(false)
  lastLoginAt        DateTime?
  // إبطال الجلسات: أي جلسة صدرت قبل هذا التاريخ تُرفض
  sessionsValidFrom  DateTime     @default(now())
  isDemo             Boolean      @default(false)
  createdAt          DateTime     @default(now())

  createdProjects      Project[]                  @relation("ProjectCreatedBy")
  assignedApplications GrantApplication[]         @relation("ApplicationAssignedTo")
  createdApplications  GrantApplication[]         @relation("ApplicationCreatedBy")
  statusChanges        ApplicationStatusHistory[]
  activityLogs         ActivityLog[]
  comments             ApplicationComment[]
  applicationVersions  ApplicationVersion[]
  uploadedDocuments    OrgDocument[]
  reportObligations    DonorReportObligation[]
  supportRecords       DonorSupportRecord[]
  correspondences      DonorCorrespondence[]

  @@index([organizationId])
}

// ملف الجمعية المركزي — مصدر واحد للحقيقة لبيانات الجمعية، تُستورد منه بيانات
// طلبات المنح تلقائيًا بدل إعادة إدخالها في كل طلب.
model Organization {
  id          String  @id @default(cuid())
  name        String
  about       String?
  accentColor String  @default("#0f766e")
  isDemo      Boolean @default(false)

  // بيانات الترخيص
  regNumber       String?
  licenseDate     DateTime?
  licenseExpiry   DateTime?
  supervisingBody String? // الجهة المشرفة
  foundedAt       DateTime?

  // النشاط والنطاق
  sector          String? // مجال الجمعية
  geographicScope String?
  city            String?
  strategicGoals  String? // JSON string[]

  // التواصل
  phone   String?
  email   String?
  website String?
  address String?

  // المفوض
  delegateName  String?
  delegateRole  String?
  delegatePhone String?
  delegateEmail String?

  // المالية
  bankName     String?
  iban         String?
  annualBudget Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users         User[]
  projects      Project[]
  donors        Donor[]
  opportunities FundingOpportunity[]
  applications  GrantApplication[]
  documents     OrgDocument[]
  boardMembers  BoardMember[]
  activityLogs  ActivityLog[]
  donorLeads    DonorLead[]
  reportObligations DonorReportObligation[]
  supportRecords    DonorSupportRecord[]
  correspondences   DonorCorrespondence[]
}

// أعضاء مجلس الإدارة والفريق التنفيذي
model BoardMember {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  position       String?
  // BOARD = مجلس إدارة | EXECUTIVE = فريق تنفيذي
  memberType     String       @default("BOARD")
  phone          String?
  email          String?
  isDemo         Boolean      @default(false)
  createdAt      DateTime     @default(now())

  @@index([organizationId])
}

// مكتبة المستندات المركزية — مستند واحد يُعاد استخدامه في عدة طلبات، مع تتبع الصلاحية
model OrgDocument {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  title          String
  // التصنيف: ترخيص، قوائم مالية، خطة استراتيجية، شهادة حوكمة، تقرير سنوي، أخرى...
  category       String
  filename       String
  storedName     String
  url            String
  mimeType       String
  size           Int
  issueDate      DateTime?
  expiryDate     DateTime?
  notes          String?
  uploadedById   String?
  uploadedBy     User?        @relation(fields: [uploadedById], references: [id])
  isDemo         Boolean      @default(false)
  uploadedAt     DateTime     @default(now())

  @@index([organizationId])
  @@index([category])
}

model Project {
  id                  String       @id @default(cuid())
  organizationId      String
  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  title               String
  category            String?
  problemStatement    String?
  generalObjective    String?
  specificObjectives  String? // JSON string[]
  beneficiaryCategory String?
  beneficiaryCount    Int?
  geographicScope     String?
  activities          String? // JSON string[]
  outputs             String? // JSON string[]
  outcomes            String? // JSON string[]
  kpis                String? // JSON [{indicator, target}]
  timelineStart       DateTime?
  timelineEnd         DateTime?
  budgetTotal         Float?
  budgetBreakdown     String? // JSON [{item, amount}]
  status              String       @default("مسودة") // مسودة / نشط / مؤرشف
  isDemo              Boolean      @default(false)
  duplicatedFromId    String?
  createdById         String
  createdBy           User         @relation("ProjectCreatedBy", fields: [createdById], references: [id])
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  attachments   Attachment[]
  applications  GrantApplication[]
  opportunities FundingOpportunity[]
  donorLeadMatches DonorLead[]
  supportRecords   DonorSupportRecord[]
}

model Donor {
  id                 String       @id @default(cuid())
  organizationId     String
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name               String
  type               String? // شركة / مؤسسة مانحة / جهة حكومية / فرد
  supportFields      String? // مجالات الدعم
  fundingConditions  String?
  contactName        String?
  phone              String?
  email              String?
  city               String?
  relationshipStatus String       @default("محتمل") // محتمل / نشط / متوقف
  notes              String?
  isDemo             Boolean      @default(false)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  opportunities FundingOpportunity[]
  attachments   Attachment[]
  supportRecords  DonorSupportRecord[]
  correspondences DonorCorrespondence[]
}

// مانح مُكتشف تلقائيًا عبر البحث اليومي بالذكاء الاصطناعي (src/lib/donor-discovery.ts).
// يبقى "مقترحًا" (PENDING) حتى يراجعه مستخدم بشري ويحوّله يدويًا إلى Donor فعلي —
// المساعد الذكي لا يُدرج بيانات في جداول الجمعية الحقيقية دون مراجعة بشرية.
model DonorLead {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name  String
  about String?
  sector String?
  city   String?
  website String?

  // مصدر الاكتشاف — رابط ونص مقتطف من نتيجة البحث، للتحقق اليدوي من صحة المعلومة
  sourceUrl     String?
  sourceSnippet String?

  // اقتراح المشروع الأنسب لرفعه لهذا المانح (اختياري، null إن لم يظهر تطابق واضح)
  suggestedProjectId String?
  suggestedProject   Project? @relation(fields: [suggestedProjectId], references: [id], onDelete: SetNull)
  matchReason        String?

  // ملاحظة اتجاه/توجه عام لاحظه المساعد الذكي أثناء هذا الاكتشاف (اختياري)
  trendNote String?

  // PENDING = مقترح ينتظر المراجعة | ADDED = أُضيف كمانح فعلي | DISMISSED = تم تجاهله
  status String @default("PENDING")

  isDemo      Boolean  @default(false)
  discoveredAt DateTime @default(now())
  reviewedAt  DateTime?

  @@index([organizationId])
  @@index([status])
}

model FundingOpportunity {
  id                String       @id @default(cuid())
  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  title             String
  donorId           String?
  donor             Donor?       @relation(fields: [donorId], references: [id])
  donorNameFreeText String?
  field             String?
  expectedAmount    Float?
  requirements      String?
  startDate         DateTime?
  deadline          DateTime?
  applicationUrl    String?
  status            String       @default("مفتوحة") // مفتوحة / تحت المتابعة / مغلقة
  projectId         String?
  project           Project?     @relation(fields: [projectId], references: [id])
  isDemo            Boolean      @default(false)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  applications GrantApplication[]
  criteria     EligibilityCriterion[]
}

model GrantApplication {
  id             String              @id @default(cuid())
  organizationId String
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  title          String
  projectId      String
  project        Project             @relation(fields: [projectId], references: [id])
  opportunityId  String?
  opportunity    FundingOpportunity? @relation(fields: [opportunityId], references: [id])

  executiveSummary   String?
  orgIntroduction    String?
  problemStatement   String?
  justification      String?
  objectives         String?
  beneficiaries      String?
  implementationPlan String?
  activities         String?
  outputs            String?
  outcomes           String?
  kpis               String?
  riskManagement     String?
  sustainability     String?
  timeline           String?
  budget             String?
  donorRequirements  String?

  status       String   @default("مسودة")
  isDemo       Boolean  @default(false)
  assignedToId String?
  assignedTo   User?    @relation("ApplicationAssignedTo", fields: [assignedToId], references: [id])
  createdById  String
  createdBy    User     @relation("ApplicationCreatedBy", fields: [createdById], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  statusHistory ApplicationStatusHistory[]
  attachments   Attachment[]
  comments      ApplicationComment[]
  versions      ApplicationVersion[]
  reportObligations DonorReportObligation[]
  supportRecords    DonorSupportRecord[]
  correspondences   DonorCorrespondence[]
}

model ApplicationStatusHistory {
  id            String           @id @default(cuid())
  applicationId String
  application   GrantApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  fromStatus    String?
  toStatus      String
  note          String?
  nextStep      String?
  changedById   String?
  changedBy     User?            @relation(fields: [changedById], references: [id])
  createdAt     DateTime         @default(now())
}

model Attachment {
  id            String            @id @default(cuid())
  filename      String
  storedName    String
  url           String
  mimeType      String
  size          Int
  projectId     String?
  project       Project?          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  applicationId String?
  application   GrantApplication? @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  donorId       String?
  donor         Donor?            @relation(fields: [donorId], references: [id], onDelete: Cascade)
  uploadedAt    DateTime          @default(now())
}

model ActivityLog {
  id             String        @id @default(cuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String?
  user           User?         @relation(fields: [userId], references: [id])
  action         String
  entityType     String
  entityId       String
  details        String?
  createdAt      DateTime      @default(now())
}

// ─────────────────────────────────────────────────────────────────────────────
// محرك أهلية المنح
// ─────────────────────────────────────────────────────────────────────────────

// شرط أهلية مرتبط بفرصة تمويل. القواعد قابلة للإضافة والتعديل من الواجهة
// دون أي تعديل في الكود — كل شرط يحدد "مفتاحًا" يُقيَّم آليًا مقابل بيانات
// الجمعية/المشروع، أو يكون تحققًا يدويًا يؤكده المستخدم.
model EligibilityCriterion {
  id               String             @id @default(cuid())
  opportunityId    String
  opportunity      FundingOpportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  // مفتاح الشرط، مثل: ORG_AGE_YEARS, ORG_SECTOR, BENEFICIARY_COUNT,
  // PROJECT_BUDGET, SELF_CONTRIBUTION_PCT, ADMIN_COST_PCT, HAS_DOCUMENT, MANUAL
  ruleKey          String
  label            String
  // عامل المقارنة: GTE, LTE, EQ, IN, EXISTS, BOOLEAN
  operator         String
  // القيمة المرجعية (نص أو رقم أو قائمة مفصولة بفواصل حسب العامل)
  value            String?
  // للشروط من نوع HAS_DOCUMENT: تصنيف المستند المطلوب
  documentCategory String?
  // إلزامي = عدم استيفائه يعني "غير مؤهل"؛ غير إلزامي = "مؤهل بشروط"
  isMandatory      Boolean            @default(true)
  notes            String?
  isDemo           Boolean            @default(false)
  createdAt        DateTime           @default(now())

  @@index([opportunityId])
}

// ─────────────────────────────────────────────────────────────────────────────
// المراجعة والتعليقات
// ─────────────────────────────────────────────────────────────────────────────

// تعليق مرتبط بحقل محدد داخل طلب المنحة (أو تعليق عام إذا كان fieldKey فارغًا)
model ApplicationComment {
  id            String           @id @default(cuid())
  applicationId String
  application   GrantApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  // مفتاح الحقل الذي يعلّق عليه المراجع (مثل executiveSummary)، أو null لتعليق عام
  fieldKey      String?
  body          String
  // OPEN = مفتوح | RESOLVED = تمت المعالجة
  status        String           @default("OPEN")
  // CHANGE_REQUEST = طلب تعديل | NOTE = ملاحظة
  kind          String           @default("NOTE")
  authorId      String
  author        User             @relation(fields: [authorId], references: [id])
  resolvedAt    DateTime?
  isDemo        Boolean          @default(false)
  createdAt     DateTime         @default(now())

  @@index([applicationId])
}

// لقطة من محتوى الطلب عند كل حفظ مهم — تتيح مقارنة الإصدارات واستعادتها
model ApplicationVersion {
  id            String           @id @default(cuid())
  applicationId String
  application   GrantApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  // كامل محتوى أقسام الطلب وقت الحفظ كـ JSON
  snapshot      String
  createdById   String?
  createdBy     User?            @relation(fields: [createdById], references: [id])
  label         String?
  createdAt     DateTime         @default(now())

  @@index([applicationId])
}

// ─────────────────────────────────────────────────────────────────────────────
// متابعة ما بعد القبول: التزامات إعداد التقارير + سجل الدعم التاريخي + المراسلات
// ─────────────────────────────────────────────────────────────────────────────

// التزام بتقديم تقرير للجهة المانحة بعد قبول طلب المنحة (تقرير مرحلي/نهائي/مالي/أثر).
// "متأخر" ليست حالة مخزَّنة — تُحسب في الواجهة بمقارنة dueDate بتاريخ اليوم طالما الحالة PENDING.
model DonorReportObligation {
  id             String           @id @default(cuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  applicationId  String
  application    GrantApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  title          String
  // تقرير مرحلي / تقرير نهائي / تقرير مالي / تقرير أثر / أخرى
  type           String           @default("تقرير مرحلي")
  dueDate        DateTime
  // PENDING = مستحق | SUBMITTED = تم التقديم
  status         String           @default("PENDING")
  submittedAt    DateTime?
  notes          String?
  createdById    String?
  createdBy      User?            @relation(fields: [createdById], references: [id])
  isDemo         Boolean          @default(false)
  createdAt      DateTime         @default(now())

  @@index([organizationId])
  @@index([applicationId])
  @@index([dueDate])
}

// سجل تاريخي لدعم فعلي قدّمته جهة مانحة (بخلاف الفرص/الطلبات قيد التقديم) — يبني صورة
// كاملة عن علاقة الجمعية بالمانح عبر السنوات، لأغراض التقارير والتعريف بالمانح.
model DonorSupportRecord {
  id             String            @id @default(cuid())
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  donorId        String
  donor          Donor             @relation(fields: [donorId], references: [id], onDelete: Cascade)
  year           Int
  amount         Float
  projectId      String?
  project        Project?          @relation(fields: [projectId], references: [id], onDelete: SetNull)
  applicationId  String?
  application    GrantApplication? @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  notes          String?
  createdById    String?
  createdBy      User?             @relation(fields: [createdById], references: [id])
  isDemo         Boolean           @default(false)
  createdAt      DateTime          @default(now())

  @@index([organizationId])
  @@index([donorId])
}

// خطاب رسمي مُولَّد للتواصل مع المانح (شكر بعد القبول، تأكيد استلام الموافقة، عام) —
// يُحفظ نصه كاملًا وقت الإنشاء كي يبقى ثابتًا حتى لو تغيّر ملف الجمعية لاحقًا.
model DonorCorrespondence {
  id             String            @id @default(cuid())
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  donorId        String
  donor          Donor             @relation(fields: [donorId], references: [id], onDelete: Cascade)
  applicationId  String?
  application    GrantApplication? @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  // THANK_YOU = خطاب شكر | ACCEPTANCE_ACK = تأكيد استلام الموافقة | GENERAL = عام
  type           String
  subject        String
  body           String
  createdById    String?
  createdBy      User?             @relation(fields: [createdById], references: [id])
  isDemo         Boolean           @default(false)
  createdAt      DateTime          @default(now())

  @@index([organizationId])
  @@index([donorId])
}
