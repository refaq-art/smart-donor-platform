# ==============================================
# منصة إدارة مشاريع ومنح الجمعيات الخيرية - إعدادات البيئة
# انسخ هذا الملف باسم .env وعدّل القيم عند الحاجة
# ==============================================

# قاعدة البيانات (SQLite محلية - لا تحتاج أي خدمة خارجية)
DATABASE_URL="file:./dev.db"

# مفتاح تشفير الجلسات (استخدم قيمة عشوائية طويلة في الإنتاج)
# يمكن توليد قيمة عشوائية عبر: openssl rand -base64 32
AUTH_SECRET="change-this-to-a-long-random-secret-in-production"

# ==============================================
# النشر السحابي المجاني (اختياري - اتركها فارغة للتشغيل المحلي)
# ==============================================
# مطلوبة فقط عند النشر على استضافة بدون قرص دائم (مثل Vercel).
# راجع قسم "النشر السحابي المجاني" في README.md للتفاصيل الكاملة.

# رابط قاعدة بيانات Turso (متوافقة مع SQLite، خطة مجانية) - يبدأ بـ libsql://
TURSO_DATABASE_URL=""
TURSO_AUTH_TOKEN=""

# مفتاح Vercel Blob لتخزين المرفقات (خطة مجانية) - يُضاف تلقائيًا عند ربط
# مخزن Blob بمشروع Vercel، لا حاجة لضبطه يدويًا عند النشر على Vercel
BLOB_READ_WRITE_TOKEN=""

# ==============================================
# إعدادات مزود الذكاء الاصطناعي
# ==============================================
# الوضع التجريبي (mock) يعمل بدون أي مفتاح API وهو الوضع الافتراضي
# لتفعيل مزود حقيقي غيّر القيمة إلى "openai" وأضف المفتاح
AI_PROVIDER="mock"

# مفتاح API (مطلوب فقط إذا كان AI_PROVIDER=openai)
# يدعم أي مزود متوافق مع OpenAI API مثل: OpenAI, Groq, Together AI, Ollama, DeepSeek
AI_API_KEY=""

# رابط قاعدة الـ API (اتركه فارغًا لاستخدام OpenAI الرسمي)
# أمثلة مجانية/منخفضة التكلفة متوافقة مع OpenAI:
#   Groq (مجاني بحدود):        https://api.groq.com/openai/v1
#   Ollama (محلي مجاني):       http://localhost:11434/v1
#   Together AI:               https://api.together.xyz/v1
AI_BASE_URL=""

# اسم النموذج المستخدم
AI_MODEL="gpt-4o-mini"

# الحد الأقصى لحجم الملف المرفوع بالميجابايت
MAX_UPLOAD_MB="10"
